
#include <iomanip>
#include <iostream>
#include <string>
using namespace std;

class Cart {
    string items[10];
    double prices[10];
    int n = 0;
    double discount = 0;

public:
    // TODO 1: Add an item and return the current object
    Cart& add(string item, double price) {
        if (n < 10) {
            items[n] = item;
            prices[n] = price;
            n++;
        }
        return *this;
    }

    // TODO 2: Set discount using this pointer
    Cart& setDiscount(double discount) {
        this->discount = discount;
        return *this;
    }

    double total() const {
        double t = 0;

        for (int i = 0; i < n; ++i) {
            t += prices[i];
        }

        return t * (100 - discount) / 100;
    }
};

int main() {
    Cart c;

    // 1. Direct access
    c.add("Rice", 60).add("Dal", 120);

    // 2. Pointer access
    Cart* p = &c;
    p->add("Oil", 180);

    // 3. Reference access
    Cart& ref = c;
    ref.setDiscount(10);

    cout << "Cart total: ";
    cout << fixed << setprecision(2) << ref.total() << '\n';

    // 4. Dynamic object using new and delete
    Cart* dynamicCart = new Cart;
    dynamicCart->add("Milk", 50);
    cout << "Dynamic cart total: " << dynamicCart->total() << '\n';
    delete dynamicCart;

    // Array of pointers to Cart objects
    Cart c1, c2, c3;

    c1.add("Book", 100);
    c2.add("Shoes", 500);
    c3.add("Pen", 50);

    Cart* carts[] = {&c1, &c2, &c3};

    Cart* highest = carts[0];

    for (int i = 1; i < 3; i++) {
        if (carts[i]->total() > highest->total()) {
            highest = carts[i];
        }
    }

    cout << "Highest cart total: " << highest->total() << '\n';

    return 0;
}
