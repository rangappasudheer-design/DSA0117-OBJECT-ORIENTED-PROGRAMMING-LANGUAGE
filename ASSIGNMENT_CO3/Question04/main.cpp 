
#include <iostream>
#include <iomanip>
using namespace std;

class Money {
private:
    long long paise;

public:
    // Parameterized constructor
    Money(long long rupees = 0, int p = 0)
        : paise(rupees * 100 + p) {
    }

    // Addition operator
    Money operator+(const Money& other) const {
        Money result;
        result.paise = paise + other.paise;
        return result;
    }

    // Subtraction operator
    Money operator-(const Money& other) const {
        Money result;
        result.paise = paise - other.paise;
        return result;
    }

    // Addition assignment operator
    Money& operator+=(const Money& other) {
        paise += other.paise;
        return *this;
    }

    // Equality operator
    bool operator==(const Money& other) const {
        return paise == other.paise;
    }

    // Less than operator
    bool operator<(const Money& other) const {
        return paise < other.paise;
    }

    // Output stream operator
    friend ostream& operator<<(ostream& out,
                               const Money& m) {
        long long value = m.paise;
        long long rupees = value / 100;
        long long p = value % 100;

        if (p < 0) {
            p = -p;
        }

        if (value < 0) {
            out << "-Rs " << -rupees << "."
                << setw(2) << setfill('0') << p;
        } else {
            out << "Rs " << rupees << "."
                << setw(2) << setfill('0') << p;
        }

        out << setfill(' ');
        return out;
    }

    // Input stream operator
    friend istream& operator>>(istream& in, Money& m) {
        long long rupees;
        int p;

        if (in >> rupees >> p) {
            m.paise = rupees * 100 + p;
        }

        return in;
    }
};

int main() {
    Money a(120, 75);
    Money b(79, 25);

    Money c = a + b;

    cout << "Addition: " << c << endl;

    cout << "Equality: "
         << boolalpha << (c == Money(200)) << endl;

    cout << "Subtraction: " << a - b << endl;

    a += b;
    cout << "After += : " << a << endl;

    Money x(0, 75);
    Money y(0, 50);

    cout << "Paise Carry: " << x + y << endl;

    return 0;
}
