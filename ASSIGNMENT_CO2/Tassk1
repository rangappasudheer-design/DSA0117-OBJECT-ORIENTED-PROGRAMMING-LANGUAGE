
#include <iostream>
using namespace std;

// Call by Value
void concessionByValue(long long fee, int percent)
{
    fee -= fee * percent / 100;
}

// Call by Reference
void concessionByReference(long long& fee, int percent)
{
    fee -= fee * percent / 100;
}

// Call by Pointer
void concessionByPointer(long long* fee, int percent)
{
    if (fee != nullptr)
    {
        *fee -= *fee * percent / 100;
    }
}

// Predict the Output
void change(int a, int& b, int* c)
{
    a += 10;
    b += 10;
    *c += 10;
}

int& bigger(int& p, int& q)
{
    return p > q ? p : q;
}

void show(int x, int y = 5, int z = 10)
{
    cout << x + y + z << ' ';
}

// Complete the Code
void applyByValue(long long fee, int percent)
{
    fee -= fee * percent / 100;
}

void applyConcession(long long& fee, int percent)
{
    fee -= fee * percent / 100;
}

int main()
{
    long long a = 45000;
    long long b = 45000;
    long long c = 45000;

    concessionByValue(a, 10);
    concessionByReference(b, 10);
    concessionByPointer(&c, 10);

    cout << "Call by Value: " << a << endl;
    cout << "Call by Reference: " << b << endl;
    cout << "Call by Pointer: " << c << endl;

    cout << "\nPredict the Output:\n";

    int x = 1, y = 2, z = 3;

    change(x, y, &z);

    cout << x << " " << y << " " << z << endl;

    bigger(x, z) = 100;

    cout << x << " " << z << endl;

    show(1);
    show(1, 2);
    show(1, 2, 3);

    cout << endl;

    cout << "\nComplete the Code:\n";

    long long hostelFee = 45000;

    applyByValue(hostelFee, 10);

    cout << "after call by value   : "
         << hostelFee << endl;

    applyConcession(hostelFee, 10);

    cout << "after call by reference: "
         << hostelFee << endl;

    return 0;
}
